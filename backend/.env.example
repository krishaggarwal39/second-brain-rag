# -------------------------------------------------------------
# Second Brain RAG — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control. Keep it chmod 600.
# `./deploy.sh --generate-secrets` fills the secrets marked [secret].
# -------------------------------------------------------------

# --- Backend API protection ---
# Coarse shared gate; nginx injects it for every caller (see README "Security model").
# [secret] Comma-separated list of valid API keys (supports multiple clients).
API_KEYS=change-me-to-a-strong-secret
# [secret] Single key. Used by nginx and the compose stacks.
API_KEY=change-me-to-a-strong-secret

# --- Authentication & JWT ---
# [secret] Startup fails if empty, <16 chars, or containing 'change-me'.
JWT_SECRET=change-me-to-a-strong-jwt-secret-do-not-use-in-production
# Token lifetime in minutes (default 8 h)
JWT_EXPIRY_MINUTES=480
# Only used with the sqlite backend (compose stacks use Postgres for users).
AUTH_DB_PATH=/app/auth_data/users.db
# Roles are managed with `python -m app.cli promote <email>` (see README).
# ADMIN_EMAILS is only applied on register/login when ALLOW_ADMIN_SELF_REGISTER=true (dev only).
ADMIN_EMAILS=
ALLOW_ADMIN_SELF_REGISTER=false

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT=60/minute
CHAT_RATE_LIMIT=5/minute
UPLOAD_RATE_LIMIT=3/minute
URL_RATE_LIMIT=2/minute
# Per-IP limit on /auth/login and /auth/register
AUTH_RATE_LIMIT=5/minute
# Failed logins per email before a temporary lockout (seconds)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Limiter storage. Empty = memory:// (or Redis automatically when CACHE_BACKEND=redis)
RATE_LIMIT_STORAGE_URI=
# CIDRs of reverse proxies whose X-Forwarded-For is trusted. Compose sets the private ranges.
TRUSTED_PROXY_CIDRS=
# Uvicorn proxy-header trust (gunicorn --forwarded-allow-ips)
FORWARDED_ALLOW_IPS=127.0.0.1

# --- File Uploads & Worker ---
# Shared by API and worker. Compose mounts the `uploads` volume at /data/uploads.
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10
CELERY_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_RESULT_EXPIRES=86400
GUNICORN_WORKERS=1

# --- LLM Providers ---
# GOOGLE_API_KEY may be a comma-separated list for quota rotation.
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_COOLDOWN_SECONDS=300
GEMINI_KEY_COOLDOWN_SECONDS=60
MAX_API_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
# Rewrite follow-up questions into standalone retrieval queries
QUERY_REWRITE=true
QUERY_REWRITE_TIMEOUT=3
# Cost estimates. Provider-specific values override the flat default.
COST_PER_1M_TOKENS=1.25
# COST_PER_1M_INPUT_GEMINI=
# COST_PER_1M_OUTPUT_GEMINI=
# COST_PER_1M_INPUT_GROQ=
# COST_PER_1M_OUTPUT_GROQ=

# --- Graph Database (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# [secret]
NEO4J_PASSWORD=change-me-strong-neo4j-password
# Set to 1 to disable GraphRAG entirely
DISABLE_GRAPH=0

# --- Redis Cache ---
REDIS_URL=redis://redis:6379/0
# [secret]
REDIS_PASSWORD=change-me-strong-redis-password
# redis: startup FAILS if Redis is unreachable (no silent in-memory fallback)
CACHE_BACKEND=redis

# --- ChromaDB ---
CHROMA_HOST=chroma
# In-network port of the chroma container (dev publishes it on 127.0.0.1:8001)
CHROMA_PORT=8000
# [secret] Server-enforced token (Authorization: Bearer)
CHROMA_AUTH_TOKEN=change-me-strong-chroma-token
# Only for running outside Docker: use a local PersistentClient if the server is down
CHROMA_ALLOW_LOCAL_FALLBACK=false

# --- Postgres (sparse index + users in the compose stacks) ---
SPARSE_BACKEND=postgres
POSTGRES_USER=second_brain
# [secret] Use URL-safe characters (deploy.sh generates hex)
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=second_brain
# Compose builds DATABASE_URL from the values above. Set it yourself only outside Docker:
# DATABASE_URL=postgresql://second_brain:password@localhost:5432/second_brain
# Only used with SPARSE_BACKEND=sqlite
BM25_DATA_DIR=/app/bm25_data

# --- Embedding & Reranking Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Tuning ---
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=250
CHILD_CHUNK_OVERLAP=50
RERANK_THRESHOLD=-5.0
RRF_K=60
RETRIEVAL_MULTIPLIER=3
MAX_CONTEXT_TOKENS=4000
USE_MMR=1
MMR_LAMBDA=0.7
# Web loader download cap (bytes)
MAX_WEB_BYTES=5242880

# --- CORS (comma-separated origins for the backend) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# --- Health checks ---
READY_CHECK_TIMEOUT=2
READY_CHECK_LLM=true
READY_LLM_CHECK_TTL=60

# --- Logging ---
LOG_FORMAT=json

# --- OpenTelemetry (Observability) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=second-brain-rag
OTEL_EXPORTER=none
# OTEL_OTLP_ENDPOINT=http://localhost:4317

# --- Optional HTTPS (compose profile "tls") ---
# DOMAIN=rag.example.com
# ACME_EMAIL=ops@example.com
# FRONTEND_PORT=127.0.0.1:8080
# REAL_IP_FROM=172.16.0.0/12
