# -------------------------------------------------------------
# Second Brain RAG — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# --- Backend API protection ---
# Comma-separated list of valid API keys (supports multiple clients).
API_KEYS=change-me-to-a-strong-secret
# Legacy single-key fallback (used if API_KEYS is not set):
API_KEY=change-me-to-a-strong-secret

# --- Rate Limiting ---
# Configurable per-route and global rate limits (tunable per deployment / load testing)
DEFAULT_RATE_LIMIT=60/minute
CHAT_RATE_LIMIT=5/minute
UPLOAD_RATE_LIMIT=3/minute
URL_RATE_LIMIT=2/minute

# --- Authentication & JWT ---
# REQUIRED: Replace with a strong random secret (minimum 16 characters).
# Server startup will fail with RuntimeError if JWT_SECRET is empty, <16 chars, or contains 'change-me'.
JWT_SECRET=change-me-to-a-strong-jwt-secret-do-not-use-in-production
JWT_EXPIRY_MINUTES=1440
AUTH_DB_PATH=/app/auth_data/users.db

# --- LLM Providers ---
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Model Configuration ---
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_COOLDOWN_SECONDS=300
MAX_API_RETRIES=3

# --- Graph Database (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password

# --- Redis Cache ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-strong-redis-password
CACHE_BACKEND=redis

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=change-me-strong-chroma-token

# --- Sparse Store Backend (sqlite or postgres) ---
SPARSE_BACKEND=sqlite
# DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/second_brain

# --- BM25 persistence path (inside the container, for sqlite backend) ---
BM25_DATA_DIR=/app/bm25_data

# --- Embedding & Reranking Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Tuning ---
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
RERANK_THRESHOLD=-5.0
RRF_K=60
RETRIEVAL_MULTIPLIER=3
MAX_CONTEXT_TOKENS=4000
MAX_FILE_SIZE_MB=10

# --- CORS (comma-separated origins for the backend) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# --- Logging ---
LOG_FORMAT=json

# --- OpenTelemetry (Observability) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=second-brain-rag
OTEL_EXPORTER=console
# OTEL_OTLP_ENDPOINT=http://localhost:4317
